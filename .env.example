# Copy to .env and adjust; compose.yml reads it. Every setting has a default.
#
# Fixed at first start: the host name and both passwords are recorded when EPM configures
# itself, and EPM can't be renamed or re-pointed afterwards. Changing any of them later
# means `docker compose down -v` (which drops the databases) and configuring again.

# EPM's host name is EPM_HOSTNAME.EPM_DOMAIN: planning.epm.test by default. Letters,
# digits, dashes and dots only. Clients that use EPM's recorded addresses (Smart View,
# Essbase clients) must resolve it to this machine: a DNS record on a server, or a line
# in /etc/hosts locally ("127.0.0.1 planning.epm.test").
EPM_HOSTNAME=planning
EPM_DOMAIN=epm.test

# Oracle's rules, which constrain each other: 16 characters or fewer, starting with a
# letter, with a digit, using only letters, digits and _. configure.sh checks them.
# MSSQL_SA_PASSWORD is SQL Server's sa password and RCU's sysDBA password; EPM_PASSWORD
# is WebLogic's epm_admin and Shared Services' admin.
MSSQL_SA_PASSWORD=Welcome1_EPM
EPM_PASSWORD=Welcome1_EPM

# EPM's memory cap. It uses about 12 GB once running.
#PLANNING_MEM_LIMIT=16g

# SQL Server's port on the host.
#MSSQL_HOST_PORT=21433
